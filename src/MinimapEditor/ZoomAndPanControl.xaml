<UserControl x:Class="MinimapEditor.ZoomAndPanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MinimapEditor"
             mc:Ignorable="d" DataContextChanged="UserControl_DataContextChanged"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Measurement and Content Host (behind, invisible but measured) -->
        <ScrollViewer x:Name="measurementViewer" Grid.Row="0" Panel.ZIndex="-1" Opacity="0" IsHitTestVisible="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="contentHost" Content="{Binding RelativeSource={RelativeSource AncestorType=local:ZoomAndPanControl}, Path=ZoomableContent}" />
        </ScrollViewer>

        <!-- Main Display -->
        <Viewbox Grid.Row="0" x:Name="theViewbox" Stretch="Uniform" MouseWheel="MouseWheelZoom">
            <Grid x:Name="viewboxContentGrid" MouseMove="viewboxContentGrid_MouseMove" MouseLeave="viewboxContentGrid_MouseLeave"
                  MouseDown="viewboxContentGrid_MouseDown" MouseUp="viewboxContentGrid_MouseUp">
                <Rectangle>
                    <Rectangle.Fill>
                        <VisualBrush x:Name="theBrush" Stretch="None" AlignmentX="Left" AlignmentY="Top" />
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
