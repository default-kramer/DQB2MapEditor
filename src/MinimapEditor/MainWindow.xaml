<Window x:Class="MinimapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinimapEditor"
        xmlns:vm="clr-namespace:MinimapEditor.Viewmodels"
        Icon="/Content/hammer256.png"
        mc:Ignorable="d"
        MinHeight="900" MinWidth="1050"
        Title="{Binding WindowTitle8643}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartupViewmodel}">
            <local:StartupControl></local:StartupControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapEditorViewmodel}">
            <local:MapEditorControl></local:MapEditorControl>
        </DataTemplate>
    </Window.Resources>
    <TabControl x:Name="mainTabControl" ItemsSource="{Binding Tabs4685}" SelectedItem="{Binding SelectedTab4149}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Header5924}"></TextBlock>
                    <Button Command="{Binding CommandCloseTab2176}" Padding="0" Background="Transparent" BorderThickness="0"
                            Margin="5,0,0,0" Width="16" Height="16" VerticalContentAlignment="Center">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCloseTab4739}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Stroke="#666" StrokeThickness="1.5" Stretch="Uniform"
                              Width="12" Height="12"
                              Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <ContentControl Content="{Binding Viewmodel2249}" DataContextChanged="ContentControl_DataContextChanged"></ContentControl>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</Window>
