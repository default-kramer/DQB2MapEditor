<Window x:Class="MinimapEditor.SaveBackupWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinimapEditor"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight" MaxWidth="340"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Title="No Automatic Backups">
    <Border Padding="15">
        <StackPanel Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding WarningIcon}"></Image>
                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock>Notice! This app does not create backups.</TextBlock>
                    <TextBlock>You should create your own backups if needed.</TextBlock>
                </StackPanel>
            </Grid>
            <CheckBox Margin="0,10,0,0" x:Name="cbDontShowAgain" HorizontalAlignment="Center" IsChecked="False">Don't show this message again</CheckBox>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="ButtonOk_Click">OK</Button>
                <Button IsDefault="True" Click="ButtonCancel_Click" Margin="20,0,0,0">Cancel</Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
