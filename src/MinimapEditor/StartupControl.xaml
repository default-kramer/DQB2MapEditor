<UserControl x:Class="MinimapEditor.StartupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MinimapEditor"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center">Choose a CMNDAT file:</TextBlock>
            <TextBox Width="400" IsReadOnly="True" Text="{Binding CmndatPath2301, Mode=OneWay}"></TextBox>
            <Button HorizontalAlignment="Center" Command="{Binding CommandBrowse1907}">Browse</Button>

            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">Choose an Island:</TextBlock>
            <ListView ItemsSource="{Binding IslandChoices8930}" SelectedItem="{Binding SelectedIsland2951}" DisplayMemberPath="IslandName3332">
            </ListView>

            <Button HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding CommandOpen9616}">Open</Button>
        </StackPanel>
    </Grid>
</UserControl>
