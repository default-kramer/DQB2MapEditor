<UserControl x:Class="MinimapEditor.TileSpecControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MinimapEditor"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel Orientation="Vertical" Margin="8" Background="White">
            <StackPanel Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding SetBaseTile7123}">Set Base Tile</CheckBox>
                <Image Margin="4,0,0,0" Source="{Binding SelectedBaseTile6495.ImageSource}"></Image>
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedBaseTile6495.Name}"></TextBlock>
            </StackPanel>
            <ListView ItemsSource="{Binding BaseTileChoices2327}" SelectedItem="{Binding SelectedBaseTile6495}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel MaxWidth="120"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Image MaxWidth="16" Source="{Binding ImageSource}"></Image>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="8" Background="White">
            <StackPanel Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding SetOverlay1367}">Set Overlay</CheckBox>
                <Image Margin="4,0,0,0" Source="{Binding SelectedOverlay8725.ImageSource}"></Image>
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedOverlay8725.Name}"></TextBlock>
            </StackPanel>
            <ListView ItemsSource="{Binding OverlayChoices4299}" SelectedItem="{Binding SelectedOverlay8725}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel MaxWidth="120"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Image MaxWidth="16" Source="{Binding ImageSource}"></Image>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="8" Background="White" DataContext="{Binding Visibility5366}">
            <TextBlock>Change Visibility?</TextBlock>
            <RadioButton GroupName="SetVisibility" IsChecked="{Binding IsNull3392}">No Change</RadioButton>
            <RadioButton GroupName="SetVisibility" IsChecked="{Binding IsTrue9880}">Set Visible</RadioButton>
            <RadioButton GroupName="SetVisibility" IsChecked="{Binding IsFalse9122}">Set Hidden</RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
